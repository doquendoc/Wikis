---
// Envuelve el cuerpo de cada página: ficha arriba; pendientes y «mencionada en» abajo.
// Todo se calcula dentro de la historia de la página.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getCollection } from 'astro:content';
import { enlazarHTML, destinos } from '../lib/wikilinks.mjs';
import { HISTORIAS, historiaDe } from '../lib/historias.mjs';
import Personaje from './Personaje.astro';
import Ficha from './Ficha.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { entry } = Astro.locals.starlightRoute;
const historia = historiaDe(entry.id);
const href = (eid: string) => base + (eid === 'index' ? '' : eid + '/');
const miHref = href(entry.id);
const { ficha, personaje, pendientes, auto, planeta } = entry.data as any;

const todas = await getCollection('docs');
const deLaHistoria = todas.filter((e) => historiaDe(e.id) === historia);
const textoDe = (e: any) =>
  [
    e.body,
    ...(e.data.ficha || []).map((f: any[]) => [f[1]].flat().join('\n')),
    ...(e.data.pendientes || []),
    e.data.personaje ? JSON.stringify(e.data.personaje) : '',
  ].join('\n');

// Quién enlaza a esta página (de cualquier historia)
const menciones = todas
  .filter((e) => e.id !== entry.id && destinos(textoDe(e), historiaDe(e.id), base).has(miHref))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'es'));

// Pendientes de toda la historia, en el orden del índice lateral
const h = HISTORIAS.find((x) => x.dir === historia);
let global: { label: string; paginas: any[] }[] = [];
let total = 0;
if (auto === 'pendientes' && h) {
  const orden = (e: any) => e.data.sidebar?.order ?? 999;
  const de = (prefijo: string) =>
    deLaHistoria
      .filter((e) => e.data.pendientes?.length && (prefijo ? e.id.startsWith(prefijo + '/') : e.id.split('/').length <= 2 && !h.secciones.some((s) => e.id.startsWith(`${historia}/${s.dir}/`))))
      .sort((a, b) => a.id.split('/').length - b.id.split('/').length || orden(a) - orden(b));
  global = [{ label: 'General', paginas: de('') }, ...h.secciones.map((s) => ({ label: s.label, paginas: de(`${historia}/${s.dir}`) }))].filter((g) => g.paginas.length);
  total = global.reduce((n, g) => n + g.paginas.reduce((m: number, p: any) => m + p.data.pendientes.length, 0), 0);
}

// Subespecie con `planeta`: se traen las condiciones de su planeta (grupo «# Condiciones»)
const planetaEntry = planeta ? deLaHistoria.find((e) => e.id.endsWith('/' + planeta)) : null;
const condiciones: any[] = [];
if (planetaEntry) {
  let dentro = false;
  for (const f of (planetaEntry.data as any).ficha || []) {
    if (f[0].startsWith('#')) dentro = /condiciones/i.test(f[0]);
    else if (dentro) condiciones.push(f);
  }
}

// Portada general: tarjetas de las historias
const portadaGeneral = entry.id === 'index' || entry.id === '';
---

<Default>
  {personaje && <Personaje p={personaje} titulo={entry.data.title} historia={historia} />}

  {!personaje && ficha?.length > 0 && <Ficha filas={ficha} historia={historia} />}
  {planetaEntry && condiciones.length > 0 && (
    <Ficha filas={condiciones} historia={historia} titulo={`Su planeta: [[${planetaEntry.id.split('/').pop()}|${planetaEntry.data.title}]]`} />
  )}

  {
    portadaGeneral && (
      <ul class="historias not-content">
        {HISTORIAS.map((x) => (
          <li>
            <a href={`${base}${x.dir}/`}>
              <span class="historia-titulo">{x.titulo}</span>
              <span class="historia-desc">{x.descripcion}</span>
              <span class="historia-n">{todas.filter((e) => historiaDe(e.id) === x.dir).length} páginas</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    auto === 'pendientes' && (
      <>
        <dl class="ficha not-content">
          <div>
            <dt>Cosas abiertas</dt>
            <dd>{total}</dd>
          </div>
          <div>
            <dt>En páginas</dt>
            <dd>{global.reduce((n, g) => n + g.paginas.length, 0)}</dd>
          </div>
        </dl>
        {global.map((g) => (
          <>
            <h2>{g.label}</h2>
            {g.paginas.map((p) => (
              <>
                <h3>
                  <a href={href(p.id)}>{p.data.title}</a>
                </h3>
                <ul>
                  {p.data.pendientes.map((t: string) => (
                    <li set:html={enlazarHTML(t, historia, base)} />
                  ))}
                </ul>
              </>
            ))}
          </>
        ))}
      </>
    )
  }

  <slot />

  {
    pendientes?.length > 0 && (
      <aside id="pendientes" class="pendientes not-content" aria-label="Pendiente de decidir">
        <p class="pendientes-titulo">Pendiente de decidir</p>
        <ul>
          {pendientes.map((t: string) => (
            <li set:html={enlazarHTML(t, historia, base)} />
          ))}
        </ul>
      </aside>
    )
  }

  {
    menciones.length > 0 && auto !== 'pendientes' && (
      <nav class="menciones not-content" aria-label="Mencionada en">
        <p class="menciones-titulo">Mencionada en</p>
        <ul>
          {menciones.map((e) => (
            <li>
              <a href={href(e.id)}>{e.data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Default>
